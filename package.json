{
  "name": "streamflix",
  "version": "2.0.0",
  "description": "StreamFlix – plateforme de streaming (Bootstrap 5 + SASS)",
  "private": true,
  "scripts": {
    "sass:build": "node node_modules/sass/sass.js scss/style.scss css/style.css --load-path=node_modules --style=compressed --source-map --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function",
    "sass:watch": "node node_modules/sass/sass.js scss/style.scss css/style.css --load-path=node_modules --style=expanded --source-map --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function --watch",
    "build": "npm run sass:build",
    "dev": "npm run sass:watch"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "sass": "^1.105.0"
  }
}
